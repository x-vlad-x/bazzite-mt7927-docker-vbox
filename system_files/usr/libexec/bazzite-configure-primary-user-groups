#!/usr/bin/bash
set -euo pipefail

groupadd --system --force docker
groupadd --system --force vboxusers

primary_user="$(
    getent passwd |
        awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ {print $1 ":" $3}' |
        sort -t: -k2,2n |
        head -n1 |
        cut -d: -f1
)"

if [[ -z "${primary_user}" ]]; then
    exit 0
fi

usermod --append --groups docker,vboxusers "${primary_user}"
